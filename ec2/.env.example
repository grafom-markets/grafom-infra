# Grafom shared infrastructure — environment variables
#
# Copy to .env and fill in values:
#   cp .env.example .env
#
# These are used by docker-compose.yml. Never commit .env with real values.

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=trading_db

# Grafana
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
