# grafom-infra — environment variables for docker-compose
#
# Copy to .env and fill in real values before running deploy.sh:
#   cp .env.example .env
#
# NEVER commit .env — it is in .gitignore.
# SEC-001: Dev credentials only. Production uses OCI Vault / AWS Secrets Manager.

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=postgres

# Grafana
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
