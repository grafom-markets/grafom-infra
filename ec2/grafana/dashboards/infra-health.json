{
  "uid": "grafom-infra-health",
  "title": "Grafom Infrastructure Health",
  "description": "Shared EC2 infrastructure overview — PostgreSQL, ClickHouse, Redis, Redpanda, Prometheus",
  "tags": ["grafom", "infrastructure"],
  "timezone": "Asia/Kolkata",
  "editable": true,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "Service Health (up/down)",
      "description": "1 = healthy, 0 = down. Based on Prometheus scrape targets.",
      "type": "stat",
      "gridPos": { "h": 4, "w": 24, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "options": { "0": { "text": "DOWN", "color": "red" } }, "type": "value" },
            { "options": { "1": { "text": "UP", "color": "green" } }, "type": "value" }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "textMode": "auto",
        "graphMode": "none"
      },
      "targets": [
        {
          "expr": "up",
          "legendFormat": "{{job}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Prometheus Memory Usage",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 536870912 },
              { "color": "red", "value": 805306368 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "process_resident_memory_bytes",
          "legendFormat": "{{job}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Prometheus Scrape Duration",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "scrape_duration_seconds",
          "legendFormat": "{{job}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Redpanda — Kafka Topic Partition Count",
      "description": "Number of partitions per topic from Redpanda metrics.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "redpanda_kafka_partitions",
          "legendFormat": "partitions",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Redpanda — Consumer Group Lag",
      "description": "Total consumer group lag across all topics.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "redpanda_kafka_consumer_group_lag_sum",
          "legendFormat": "{{group}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "ClickHouse — Queries per Second",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "rate(ClickHouseProfileEvents_Query[5m])",
          "legendFormat": "queries/s",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "ClickHouse — Memory Usage",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "ClickHouseMetrics_MemoryTracking",
          "legendFormat": "memory tracked",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "title": "ClickHouse — Table Row Counts (grafom DB)",
      "description": "Row counts per table in the grafom ClickHouse database.",
      "type": "table",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 28 },
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "" },
      "targets": [
        {
          "rawSql": "SELECT name AS table, total_rows AS rows, formatReadableSize(total_bytes) AS size FROM system.tables WHERE database = 'grafom' AND total_rows > 0 ORDER BY total_rows DESC",
          "refId": "A",
          "format": 1
        }
      ]
    },
    {
      "id": 9,
      "title": "PostgreSQL — Database Sizes",
      "description": "Size of each grafom_* database on the shared PostgreSQL instance.",
      "type": "table",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 28 },
      "datasource": { "type": "postgres", "uid": "" },
      "targets": [
        {
          "rawSql": "SELECT datname AS database, pg_size_pretty(pg_database_size(datname)) AS size FROM pg_database WHERE datname LIKE 'grafom_%' ORDER BY pg_database_size(datname) DESC",
          "refId": "A",
          "format": "table"
        }
      ]
    },
    {
      "id": 10,
      "title": "Prometheus — TSDB Head Series",
      "description": "Number of active time series in Prometheus.",
      "type": "stat",
      "gridPos": { "h": 4, "w": 8, "x": 0, "y": 36 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "textMode": "auto",
        "graphMode": "area"
      },
      "targets": [
        {
          "expr": "prometheus_tsdb_head_series",
          "legendFormat": "series",
          "refId": "A"
        }
      ]
    },
    {
      "id": 11,
      "title": "Prometheus — Samples Ingested/s",
      "type": "stat",
      "gridPos": { "h": 4, "w": 8, "x": 8, "y": 36 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "textMode": "auto",
        "graphMode": "area"
      },
      "targets": [
        {
          "expr": "rate(prometheus_tsdb_head_samples_appended_total[5m])",
          "legendFormat": "samples/s",
          "refId": "A"
        }
      ]
    },
    {
      "id": 12,
      "title": "ClickHouse — Active Connections",
      "type": "stat",
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 36 },
      "datasource": { "type": "prometheus", "uid": "PBFA97CFB590B2093" },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "textMode": "auto",
        "graphMode": "area"
      },
      "targets": [
        {
          "expr": "ClickHouseMetrics_TCPConnection + ClickHouseMetrics_HTTPConnection",
          "legendFormat": "connections",
          "refId": "A"
        }
      ]
    }
  ],
  "schemaVersion": 38,
  "version": 1
}
